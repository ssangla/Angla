# ============================================================
# ANGLA — Environment Variables
# Copy this file to .env and fill in your values
# ============================================================

# Firebase Configuration
# Get these from: Firebase Console -> Project Settings -> General -> Your apps
EXPO_PUBLIC_FIREBASE_API_KEY=your_api_key_here
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=angla-app.firebaseapp.com
EXPO_PUBLIC_FIREBASE_PROJECT_ID=angla-app
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=angla-app.firebasestorage.app
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=000000000000
EXPO_PUBLIC_FIREBASE_APP_ID=1:000:web:000

# Google Sign-In (optional)
EXPO_PUBLIC_GOOGLE_CLIENT_ID=your_google_client_id_here

# OpenAI API Key (for AI Coach - Phase 2)
OPENAI_API_KEY=your_openai_key_here
