# Firebase Configuration for Dfabrik-dev project
# Copy this file to .env.local and fill in the values from Firebase Console
# https://console.firebase.google.com/project/dfabrik-dev/settings/general

EXPO_PUBLIC_FIREBASE_API_KEY=your_firebase_api_key
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
EXPO_PUBLIC_FIREBASE_APP_ID=your_app_id
EXPO_PUBLIC_FIREBASE_MEASUREMENT_ID=your_measurement_id

# Anthropic API key for invoice scanning (Claude Vision)
EXPO_PUBLIC_ANTHROPIC_API_KEY=your_anthropic_api_key
